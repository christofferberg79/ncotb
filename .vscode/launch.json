{
    "version": "0.2.0",
    "configurations": [
        {
            // Optimized build (RelWithDebInfo, build/) for running at full speed.
            // Start it with Ctrl+F5 (Run Without Debugging) to skip the debugger entirely.
            "name": "Run app (release)",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/build/app/ncotb",
            "windows": { "program": "${workspaceFolder}/build/app/ncotb.exe" },
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "build (release)"
        },
        {
            "name": "Debug app",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/build-debug/app/ncotb",
            "windows": { "program": "${workspaceFolder}/build-debug/app/ncotb.exe" },
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "build (debug)"
        },
        {
            "name": "Debug tests",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/build-debug/tests/physics_tests",
            "windows": { "program": "${workspaceFolder}/build-debug/tests/physics_tests.exe" },
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "build (debug)"
        },
        {
            "name": "Debug tests (filter by name)",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/build-debug/tests/physics_tests",
            "windows": { "program": "${workspaceFolder}/build-debug/tests/physics_tests.exe" },
            "args": ["--test-case=${input:testCase}", "--break"],
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "build (debug)"
        },
        {
            // Stops in the debugger at the first memory error or undefined behaviour.
            "name": "Debug tests (ASan/UBSan)",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/build-asan/tests/physics_tests",
            "windows": { "program": "${workspaceFolder}/build-asan/tests/physics_tests.exe" },
            "cwd": "${workspaceFolder}",
            "env": { "UBSAN_OPTIONS": "print_stacktrace=1" },
            "preLaunchTask": "build (asan)"
        },
        {
            "name": "Debug app (ASan/UBSan)",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/build-asan/app/ncotb",
            "windows": { "program": "${workspaceFolder}/build-asan/app/ncotb.exe" },
            "cwd": "${workspaceFolder}",
            "env": { "UBSAN_OPTIONS": "print_stacktrace=1" },
            "preLaunchTask": "build (asan)"
        }
    ],
    "inputs": [
        {
            "id": "testCase",
            "type": "promptString",
            "description": "doctest test case name (wildcards allowed, e.g. *free fall*)",
            "default": "*"
        }
    ]
}
