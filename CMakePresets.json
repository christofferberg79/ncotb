{
    "version": 6,
    "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "generator": "Ninja",
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "CMAKE_C_COMPILER": "clang",
                "CMAKE_CXX_COMPILER": "clang++"
            }
        },
        {
            "name": "debug",
            "displayName": "Debug",
            "description": "Unoptimized, full debug info (for the debugger)",
            "inherits": "base",
            "binaryDir": "${sourceDir}/build-debug",
            "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
        },
        {
            "name": "release",
            "displayName": "Release (RelWithDebInfo)",
            "description": "Optimized with debug info (for running at full speed)",
            "inherits": "base",
            "binaryDir": "${sourceDir}/build",
            "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo" }
        },
        {
            "name": "asan",
            "displayName": "Debug + ASan/UBSan",
            "description": "Debug build of our code with AddressSanitizer and UndefinedBehaviorSanitizer",
            "inherits": "base",
            "binaryDir": "${sourceDir}/build-asan",
            "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "NCOTB_SANITIZE": "ON" }
        },
        {
            "name": "package",
            "displayName": "Release package",
            "description": "Release build for distribution: universal macOS app bundle / Windows GUI exe (cpack --preset package)",
            "inherits": "base",
            "binaryDir": "${sourceDir}/build-package",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "NCOTB_PACKAGE": "ON",
                "CMAKE_OSX_ARCHITECTURES": "arm64;x86_64",
                "CMAKE_OSX_DEPLOYMENT_TARGET": "11.0"
            }
        }
    ],
    "buildPresets": [
        { "name": "debug", "configurePreset": "debug" },
        { "name": "release", "configurePreset": "release" },
        { "name": "asan", "configurePreset": "asan" },
        { "name": "package", "configurePreset": "package" }
    ],
    "testPresets": [
        { "name": "debug", "configurePreset": "debug", "output": { "outputOnFailure": true } },
        { "name": "release", "configurePreset": "release", "output": { "outputOnFailure": true } },
        { "name": "asan", "configurePreset": "asan", "output": { "outputOnFailure": true } },
        { "name": "package", "configurePreset": "package", "output": { "outputOnFailure": true } }
    ],
    "packagePresets": [
        { "name": "package", "configurePreset": "package" }
    ]
}
